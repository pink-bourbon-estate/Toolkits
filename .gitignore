# build output
target/
**/target/
# local cross-compile settings
.cargo/
# never commit personal files, music, books or app data
*.pdf
*.mid
*.midi
*.mxl
*.musicxml
progress.json
annotations.json
# secrets
.env
.env.*
*.pem
*.key
*.pfx
*.p12
id_rsa*

# …except the built-in, freely licensed repertoire
!pianocraft/repertoire/*.mid

# Python bytecode caches
__pycache__/
*.pyc

# BakeCraft app data
current_plan.json
settings.json
